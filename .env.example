# Run npm run setup:env to generate private local secrets.
APP_ORIGIN=http://127.0.0.1:3001
AUTH_MODE=session
AUTH_SECRET=
# Use github for account-based ownership. Callback: <APP_ORIGIN>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AGENT_SERVICE_URL=http://127.0.0.1:8000
AGENT_SERVICE_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Local testing persists real embeddings on disk and needs no Pinecone account.
VECTOR_BACKEND=local
# For Pinecone, set VECTOR_BACKEND=pinecone and configure an existing dense,
# cosine index. No cloud index is created automatically.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
# Alternatively configure an index name instead of its host.
PINECONE_INDEX_NAME=
SERPAPI_KEY=
DOCUMENTAI_DATA_DIR=.data
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
